flowchart TD
    subgraph PREP["Model preparation"]
        DATA["Verified whole-plant sorghum photos with cultivar labels"] --> TRAIN["Train and validate sorghum cultivar classifier"]
        TRAIN --> QUANTIZE["Quantize to INT8 and calibrate probabilities"]
        QUANTIZE --> MODEL["Package MobileNetV3-Small sorghum model"]
        DATA --> PGMFIT["Fit and validate small Bayesian network"]
        PGMFIT --> PGM_PARAMS["Package Bayesian network parameters"]
    end

    subgraph DEVICE["Android app - offline"]
        PHOTO["Capture whole-plant photo"] --> PREPROCESS["Crop, resize, normalize"]
        PREPROCESS --> INFER["On-device INT8 image classification"]
        INFER --> PROBS["Probabilities for known sorghum cultivars"]
        PROBS --> USE_PGM{"Use Bayesian PGM?"}
        USE_PGM -->|Yes| INFER_PGM["Combine with validated independent evidence"]
        INFER_PGM --> POSTERIOR["Posterior sorghum cultivar probabilities"]
        USE_PGM -->|No| POSTERIOR
        POSTERIOR --> CONFIDENCE{"Confidence above threshold?"}
        CONFIDENCE -->|Yes| RESULT["Show predicted sorghum cultivar and confidence"]
        CONFIDENCE -->|No| UNCERTAIN["Show uncertain or unrecognized cultivar"]
    end

    MODEL -. "Bundled with app" .-> INFER
    PGM_PARAMS -. "Bundled with app" .-> INFER_PGM
